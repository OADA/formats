{
  "name": "@oada/schemas",
  "version": "4.1.1",
  "author": "Alex Layton <alex@layton.in>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./**/*.schema": "./dist/**/*.schema.cjs",
    "./utils": "./dist/utils.cjs"
  },
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "yarn g:tsc",
    "clean": "yarn g:tsc --clean && rm -rf dist",
    "test": "ava",
    "test:debug": "ava -T 60m -svc 1 --no-worker-threads"
  },
  "ava": {
    "failFast": false,
    "files": [
      "**/*.spec.ts"
    ],
    "typescript": {
      "extensions": [
        "ts",
        "cts",
        "mts"
      ],
      "rewritePaths": {
        "/": "dist/"
      },
      "compile": false
    }
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.9.3",
    "@ava/typescript": "^7.0.0",
    "@types/glob": "^9.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/lodash.get": "^4.4.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^20.19.41",
    "ajv": "^8.20.0",
    "ava": "^8.0.1",
    "csv-parse": "^6.2.1",
    "deep-freeze-node": "^1.1.3",
    "glob": "^13.0.6",
    "jsonschema8": "^2.0.0",
    "tslib": "^2.8.1",
    "type-fest": "^5.6.0"
  },
  "dependencies": {
    "lodash.get": "^4.4.2",
    "lodash.merge": "^4.6.2"
  }
}
